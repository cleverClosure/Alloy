{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/mgcr/game-profile.v1.schema.json",
  "title": "Mac Gaming Compatibility Runtime Game Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "revision", "game", "selectors", "runtime", "processPolicies", "certification"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "profileId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalId", "displayName", "storefronts"],
      "properties": {
        "canonicalId": {"type": "string"},
        "displayName": {"type": "string"},
        "publisher": {"type": "string"},
        "storefronts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "appId"],
            "properties": {
              "kind": {"enum": ["steam", "gog", "epic", "battle.net", "ubisoft", "rockstar", "standalone", "other"]},
              "appId": {"type": "string"},
              "branch": {"type": "string"}
            }
          }
        }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameBuild", "host"],
      "properties": {
        "gameBuild": {"$ref": "#/$defs/buildSelector"},
        "launcherBuild": {"$ref": "#/$defs/buildSelector"},
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["architecture", "macos"],
          "properties": {
            "architecture": {"const": "arm64"},
            "macos": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {"type": "string"},
                "maxExclusive": {"type": "string"},
                "allowedBuilds": {"type": "array", "items": {"type": "string"}}
              }
            },
            "gpuFamilies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "memoryClassesGiB": {"type": "array", "items": {"type": "integer", "minimum": 8}, "uniqueItems": true}
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "layers", "cpuProvider", "defaultGraphicsProvider"],
      "properties": {
        "generation": {"type": "string"},
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "digest"],
            "properties": {
              "role": {"enum": ["host", "wine", "dependencies", "profile", "tooling"]},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "size": {"type": "integer", "minimum": 0}
            }
          }
        },
        "cpuProvider": {"enum": ["fex-arm64ec", "rosetta-x64-bootstrap", "native-arm64ec"]},
        "defaultGraphicsProvider": {"enum": ["metal12", "dxmt", "moltenvk"]},
        "syncProvider": {"enum": ["adaptive", "wait-address", "mach-semaphore", "conservative"]},
        "windowsVersion": {"type": "string"},
        "locale": {"type": "string"},
        "timezoneMode": {"enum": ["host", "fixed"]}
      }
    },
    "processPolicies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/processPolicy"}
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driveMappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["letter", "target", "access"],
            "properties": {
              "letter": {"type": "string", "pattern": "^[A-Z]$"},
              "target": {"enum": ["runtime", "game", "saves", "settings", "cache", "temp", "user-grant"]},
              "access": {"enum": ["read-only", "read-write"]},
              "grantId": {"type": "string"}
            }
          }
        },
        "caseMode": {"enum": ["windows-insensitive", "host-native"]},
        "denyHostRoot": {"type": "boolean", "default": true}
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sets": {"type": "array", "items": {"$ref": "#/$defs/registryMutation"}},
        "deletes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "installMode"],
        "properties": {
          "id": {"type": "string"},
          "source": {"enum": ["bundled-licensed", "storefront", "publisher", "user-download"]},
          "installMode": {"enum": ["layer", "first-run", "launcher-managed"]},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "licenseGate": {"type": "string"}
        }
      }
    },
    "healthChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "severity"],
        "properties": {
          "kind": {"enum": ["process-started", "window-created", "module-loaded", "log-pattern", "frame-presented", "clean-exit", "save-written", "network-endpoint"]},
          "target": {"type": "string"},
          "deadlineSeconds": {"type": "integer", "minimum": 1},
          "severity": {"enum": ["informational", "degraded", "fatal"]}
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultLevel": {"enum": ["off", "essential", "diagnostic", "lab"]},
        "redactionPolicy": {"type": "string"},
        "sampling": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "testedAt", "testPlanId", "matrixDigest"],
      "properties": {
        "level": {"enum": ["experimental", "launches", "playable", "certified", "competitive-certified"]},
        "testedAt": {"type": "string", "format": "date-time"},
        "testPlanId": {"type": "string"},
        "matrixDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "knownLimitations": {"type": "array", "items": {"type": "string"}},
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "buildSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string"},
        "manifestId": {"type": "string"},
        "requiredFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size": {"type": "integer", "minimum": 0},
              "peTimestamp": {"type": "integer", "minimum": 0}
            }
          }
        }
      },
      "anyOf": [
        {"required": ["version"]},
        {"required": ["manifestId"]},
        {"required": ["requiredFiles"]}
      ]
    },
    "processPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "match", "execution"],
      "properties": {
        "id": {"type": "string"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100000},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pathGlob": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "peMachine": {"enum": ["x86", "x64", "arm64", "arm64ec"]},
            "productName": {"type": "string"},
            "parentPolicyId": {"type": "string"},
            "commandLineRegex": {"type": "string"},
            "moduleFingerprint": {"type": "array", "items": {"type": "string"}}
          },
          "minProperties": 1
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpuProvider": {"enum": ["inherit", "fex-arm64ec", "rosetta-x64-bootstrap", "native-arm64ec"]},
            "graphicsProvider": {"enum": ["inherit", "metal12", "dxmt", "moltenvk"]},
            "syncProvider": {"enum": ["inherit", "adaptive", "wait-address", "mach-semaphore", "conservative"]},
            "featureMask": {"type": "string"},
            "dllOverrides": {"type": "object", "additionalProperties": {"enum": ["builtin", "native", "disabled", "native,builtin", "builtin,native"]}},
            "environment": {"type": "object", "additionalProperties": {"type": "string"}},
            "workingDirectory": {"type": "string"},
            "networkPolicy": {"enum": ["inherit", "allow", "deny", "publisher-only"]},
            "debugPolicy": {"enum": ["off", "crash-only", "diagnostic", "capture"]}
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "audio": {"type": "string"},
            "input": {"type": "string"},
            "media": {"type": "string"},
            "presentation": {"type": "string"},
            "storage": {"type": "string"}
          }
        }
      }
    },
    "registryMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "type", "value"],
      "properties": {
        "key": {"type": "string"},
        "name": {"type": "string"},
        "type": {"enum": ["REG_SZ", "REG_EXPAND_SZ", "REG_DWORD", "REG_QWORD", "REG_BINARY", "REG_MULTI_SZ"]},
        "value": {}
      }
    }
  }
}
