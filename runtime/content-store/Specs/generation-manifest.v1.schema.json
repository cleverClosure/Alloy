{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/alloy/content-store/generation-manifest.v1.schema.json",
  "$comment": "Author: Timur Isaev",
  "title": "Alloy Local Generation Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameId", "generationId", "layers"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "gameId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "generationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest", "mediaType", "size", "role"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "host-runtime",
            "wine-runtime",
            "cpu-provider",
            "graphics-provider",
            "native-service",
            "shader-compiler",
            "dependency",
            "profile"
          ]
        },
        "sourceRevision": {
          "type": "string"
        },
        "licenseId": {
          "type": "string"
        },
        "sbomDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "symbolsDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
