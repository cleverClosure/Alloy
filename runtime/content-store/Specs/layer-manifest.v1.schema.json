{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/alloy/content-store/layer-manifest.v1.schema.json",
  "$comment": "Author: Timur Isaev",
  "title": "Alloy Layer Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "mediaType",
    "targetArchitecture",
    "minimumHostCapability",
    "fileTreeDigest",
    "sourceRevision",
    "buildRecipeDigest",
    "allowedCompositionRoles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "mediaType": {
      "const": "application/vnd.alloy.layer.v1+tar+zstd"
    },
    "targetArchitecture": {
      "enum": ["arm64", "arm64ec", "x86_64", "any"]
    },
    "minimumHostCapability": {
      "type": "string",
      "minLength": 1
    },
    "fileTreeDigest": {
      "$ref": "#/$defs/digest"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "buildRecipeDigest": {
      "$ref": "#/$defs/digest"
    },
    "allowedCompositionRoles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "requiredFeatures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "licenseSpdxDigest": {
      "$ref": "#/$defs/digest"
    },
    "provenanceDigest": {
      "$ref": "#/$defs/digest"
    },
    "symbolsDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "role": {
      "enum": [
        "host-runtime",
        "wine-runtime",
        "cpu-provider",
        "graphics-provider",
        "native-service",
        "shader-compiler",
        "dependency",
        "profile"
      ]
    }
  }
}
