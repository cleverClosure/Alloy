  {
    "name": "compose-restrictions",
    "clean": {
      "rules": [
        {
          "id": "allow",
          "priority": 100,
          "match": {
            "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "execution": {
            "graphicsProvider": "metal12",
            "networkPolicy": "allow",
            "dllOverrides": {
              "Bad.DLL": "native"
            }
          }
        },
        {
          "id": "restrict",
          "priority": 0,
          "match": {
            "pathGlob": "**/*.exe"
          },
          "execution": {
            "networkPolicy": "deny",
            "dllOverrides": {
              "bad": "disabled"
            }
          }
        }
      ],
      "expectedRuleIds": [
        "allow"
      ],
      "graphics": "metal12",
      "network": "deny",
      "disabled": "bad"
    },
    "counterfactual": {
      "rules": [
        {
          "id": "allow",
          "priority": 100,
          "match": {
            "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "execution": {
            "graphicsProvider": "metal12",
            "networkPolicy": "allow",
            "dllOverrides": {
              "Bad.DLL": "native"
            }
          }
        }
      ],
      "expectedRuleIds": [
        "allow"
      ],
      "graphics": "metal12",
      "network": "allow"
    }
  },
