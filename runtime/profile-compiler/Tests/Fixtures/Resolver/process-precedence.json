[
  {
    "name": "digest-before-path",
    "clean": {
      "rules": [
        {
          "id": "digest",
          "priority": 0,
          "match": {
            "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "execution": {
            "graphicsProvider": "metal12"
          }
        },
        {
          "id": "path",
          "priority": 100,
          "match": {
            "pathGlob": "**/game.exe"
          },
          "execution": {
            "graphicsProvider": "dxmt"
          }
        }
      ],
      "expectedRuleIds": [
        "digest"
      ],
      "graphics": "metal12",
      "network": "deny"
    },
    "counterfactual": {
      "rules": [
        {
          "id": "digest",
          "priority": 0,
          "match": {
            "pathGlob": "**/game.exe"
          },
          "execution": {
            "graphicsProvider": "metal12"
          }
        },
        {
          "id": "path",
          "priority": 100,
          "match": {
            "pathGlob": "**/game.exe"
          },
          "execution": {
            "graphicsProvider": "dxmt"
          }
        }
      ],
      "expectedRuleIds": [
        "path"
      ],
      "graphics": "dxmt",
      "network": "deny"
    }
  },
