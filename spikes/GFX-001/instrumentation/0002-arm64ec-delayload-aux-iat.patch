+static SIZE_T arm64ec_section_remaining( HMODULE module, ULONG rva )
+{
+    IMAGE_NT_HEADERS *nt = RtlImageNtHeader( module );
+    IMAGE_SECTION_HEADER *sec;
+    ULONG i;
+
+    if (!nt || rva >= nt->OptionalHeader.SizeOfImage) return 0;
+    sec = IMAGE_FIRST_SECTION( nt );
+    for (i = 0; i < nt->FileHeader.NumberOfSections; i++, sec++)
+    {
+        ULONG end = sec->VirtualAddress + sec->Misc.VirtualSize;
+
+        if (rva >= sec->VirtualAddress && rva < end) return end - rva;
+    }
+    return 0;
+}
+
+
+static BOOL arm64ec_import_thunk_targets( HMODULE module, const void *thunk, const void *iat )
+{
+    IMAGE_NT_HEADERS *nt = RtlImageNtHeader( module );
+    const ULONG *code = thunk;
+    ULONG_PTR base = (ULONG_PTR)module, target;
+    LONGLONG imm;
+
+    if (!nt || (ULONG_PTR)thunk < base ||
+        (ULONG_PTR)thunk + 2 * sizeof(*code) > base + nt->OptionalHeader.SizeOfImage)
+        return FALSE;
+
+    /* ARM64EC __impchk_ thunks start with:
+     *   adrp x11, iat
+     *   ldr  x11, [x11, #offset]
+     */
+    if ((code[0] & 0x9f00001f) != 0x9000000b ||
+        (code[1] & 0xffc003ff) != 0xf940016b)
+        return FALSE;
+
+    imm = ((code[0] >> 29) & 3) | ((code[0] >> 3) & 0x1ffffc);
+    if (imm & 0x100000) imm -= 0x200000;
+    target = ((ULONG_PTR)thunk & ~(ULONG_PTR)0xfff) + imm * 0x1000;
+    target += ((code[1] >> 10) & 0xfff) * sizeof(void *);
+    return target == (ULONG_PTR)iat;
+}
+
+
+/***********************************************************************
+ *           arm64ec_redirect_delayload
+ *
+ * Fast-forward the auxiliary delay IAT entry that corresponds to a newly
+ * resolved regular IAT slot.  The immutable auxiliary copy contains the
+ * __impchk_ thunk for each slot, which in turn identifies the regular IAT
+ * address without relying on linker-specific table grouping.
+ */
+void *arm64ec_redirect_delayload( HMODULE module, IMAGE_THUNK_DATA *iat,
+                                  HMODULE target_module, void *ptr )
+{
+    IMAGE_ARM64EC_METADATA *metadata = arm64ec_get_module_metadata( module );
+    ULONG_PTR *aux, *copy;
+    SIZE_T aux_size, copy_size, count, i;
+    ULONG protect_old;
+    void *redirected, *protect_base;
+
+    if (!metadata || metadata->Version < 2 || !metadata->AuxiliaryDelayloadIAT ||
+        !metadata->AuxiliaryDelayloadIATCopy)
+        return ptr;
+
+    redirected = arm64ec_redirect_entry( target_module, ptr );
+    if (redirected == ptr) return ptr;
+
+    aux = get_rva( module, metadata->AuxiliaryDelayloadIAT );
+    copy = get_rva( module, metadata->AuxiliaryDelayloadIATCopy );
+    aux_size = arm64ec_section_remaining( module, metadata->AuxiliaryDelayloadIAT );
+    copy_size = arm64ec_section_remaining( module, metadata->AuxiliaryDelayloadIATCopy );
+    count = min( aux_size, copy_size ) / sizeof(*aux);
+
+    for (i = 0; i < count; i++)
+    {
+        SIZE_T protect_size = sizeof(*aux);
+
+        if (!copy[i] || !arm64ec_import_thunk_targets( module, (void *)copy[i], iat )) continue;
+
+        protect_base = aux + i;
+        if (!NtProtectVirtualMemory( NtCurrentProcess(), &protect_base, &protect_size,
+                                     PAGE_READWRITE, &protect_old ))
+        {
+            aux[i] = (ULONG_PTR)redirected;
+            NtProtectVirtualMemory( NtCurrentProcess(), &protect_base, &protect_size,
+                                    protect_old, &protect_old );
+            TRACE( "fast-forwarded delay IAT %p auxiliary slot %p from %p to %p\n",
+                   iat, aux + i, ptr, redirected );
+            return ptr;
+        }
+        WARN( "failed to make auxiliary delay IAT slot %p writable\n", aux + i );
+        break;
+    }
+    return ptr;
+}
+
