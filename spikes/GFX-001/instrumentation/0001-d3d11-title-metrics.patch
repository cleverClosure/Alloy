diff --git a/src/d3d11/d3d11_title_metrics.hpp b/src/d3d11/d3d11_title_metrics.hpp
new file mode 100644
--- /dev/null
+++ b/src/d3d11/d3d11_title_metrics.hpp
@@ -0,0 +1,92 @@
+#pragma once
+
+#include "util_env.hpp"
+#include "util_string.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+namespace dxmt {
+
+class TitleMetrics {
+public:
+  static TitleMetrics &instance() {
+    static TitleMetrics metrics;
+    return metrics;
+  }
+
+  uint64_t timestampNs() const {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now() - started_)
+        .count();
+  }
+
+  void recordPresent(uint64_t frame, uint64_t started_ns) {
+    const auto finished_ns = timestampNs();
+    write(finished_ns, "present", frame, finished_ns - started_ns, "ok", "");
+  }
+
+  void recordShader(const std::string &name, bool cache_hit, bool success,
+                    uint64_t started_ns) {
+    const auto finished_ns = timestampNs();
+    write(finished_ns, "shader", nextEvent(), finished_ns - started_ns,
+          success ? "ok" : "error",
+          std::string(cache_hit ? "cache:" : "compile:") + name);
+  }
+
+  void recordPipeline(const char *kind, bool success, uint64_t started_ns) {
+    const auto finished_ns = timestampNs();
+    write(finished_ns, "pipeline", nextEvent(), finished_ns - started_ns,
+          success ? "ok" : "error", kind);
+  }
+
+private:
+  TitleMetrics() {
+    const auto path = env::getEnvVar("DXMT_METRICS_PATH");
+    if (path.empty())
+      return;
+
+    stream_ = std::ofstream(str::topath(path.c_str()).c_str(),
+                            std::ios::out | std::ios::trunc);
+    if (stream_) {
+      stream_ << "timestamp_ns\tevent\tobject\tduration_ns\tstatus\tdetail\n";
+      stream_.flush();
+    }
+  }
+
+  uint64_t nextEvent() {
+    return next_event_.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  void write(uint64_t timestamp_ns, const char *event, uint64_t object,
+             uint64_t duration_ns, const char *status, std::string detail) {
+    for (auto &character : detail) {
+      if (character == '\t' || character == '\r' || character == '\n')
+        character = ' ';
+    }
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!stream_)
+      return;
+
+    stream_ << timestamp_ns << '\t' << event << '\t' << object << '\t'
+            << duration_ns << '\t' << status << '\t' << detail << '\n';
+    record_count_++;
+    if (std::string_view(event) != "present" || record_count_ % 60 == 0)
+      stream_.flush();
+  }
+
+  const std::chrono::steady_clock::time_point started_ =
+      std::chrono::steady_clock::now();
+  std::atomic_uint64_t next_event_{1};
+  std::ofstream stream_;
+  std::mutex mutex_;
+  uint64_t record_count_ = 0;
+};
+
+} // namespace dxmt
