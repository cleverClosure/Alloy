+static void alloy_ascii_to_wide( const char *source, WCHAR *dest )
+{
+    while ((*dest++ = (unsigned char)*source++));
+}
+
+static NTSTATUS alloy_apply_process_fields( const struct ap2_entry *policy, const char **reason )
+{
+    WCHAR name[64], value[512];
+    UNICODE_STRING nameW, valueW;
+    NTSTATUS status;
+    unsigned int i;
+    const IMAGE_NT_HEADERS *nt = RtlImageNtHeader( NtCurrentTeb()->Peb->ImageBaseAddress );
+
+    *reason = "policy-cpu-incompatible";
+    if (!nt) return STATUS_INVALID_IMAGE_FORMAT;
+    alloy_cpu_provider = policy->cpu;
+    /* Native-only is fail-closed for translated or hybrid x64 images. The
+     * ARM64EC loader itself needs translator callbacks; do not promise otherwise. */
+    if (policy->cpu == 1 && nt->FileHeader.Machine != IMAGE_FILE_MACHINE_ARM64)
+        return STATUS_NOT_SUPPORTED;
+    if (policy->cpu == 2 && nt->FileHeader.Machine != IMAGE_FILE_MACHINE_ARM64 &&
+        nt->FileHeader.Machine != IMAGE_FILE_MACHINE_AMD64 &&
+        nt->FileHeader.Machine != IMAGE_FILE_MACHINE_ARM64EC)
+        return STATUS_NOT_SUPPORTED;
+    *reason = "policy-environment-apply";
+    for (i = 0; i < policy->environment_count; i++)
+    {
+        alloy_ascii_to_wide( policy->environment[i].key, name );
+        alloy_ascii_to_wide( policy->environment[i].value, value );
+        RtlInitUnicodeString( &nameW, name );
+        RtlInitUnicodeString( &valueW, value );
+        if ((status = RtlSetEnvironmentVariable( NULL, &nameW, &valueW ))) return status;
+    }
+    if (policy->presence & 8)
+    {
+        *reason = "policy-working-directory-apply";
+        alloy_ascii_to_wide( policy->working, value );
+        RtlInitUnicodeString( &valueW, value );
+        if ((status = RtlSetCurrentDirectory_U( &valueW ))) return status;
+    }
+    if (policy->presence & 1)
+    {
+        *reason = "policy-provider-path-apply";
+        alloy_ascii_to_wide( policy->directory, value );
+        if ((status = prepend_alloy_provider_path( value ))) return status;
+    }
+    return STATUS_SUCCESS;
+}
+
 static void alloy_policy_bootstrap(void)
 {
     static const char hex[] = "0123456789abcdef";
     struct alloy_policy_bootstrap_params params = {0};
     char digest[ALLOY_POLICY_SHA256_SIZE * 2 + 1];
+    const char *reason = "policy-image-hash";
     NTSTATUS status;
     unsigned int i;
 
@@ -4515,7 +4569,7 @@ static void alloy_policy_bootstrap(void)
     params.query_only = FALSE;
     if ((status = hash_process_image( params.image_sha256 ))) goto failed;
     if ((status = WINE_UNIX_CALL( unix_alloy_policy_bootstrap, &params ))) goto failed;
-    if ((status = prepend_alloy_provider_path( params.provider_path ))) goto failed;
+    if ((status = alloy_apply_process_fields( &params.entry, &reason ))) goto failed;
 
     for (i = 0; i < ALLOY_POLICY_SHA256_SIZE; i++)
     {
@@ -4523,12 +4577,13 @@ static void alloy_policy_bootstrap(void)
         digest[i * 2 + 1] = hex[params.image_sha256[i] & 0x0f];
     }
     digest[sizeof(digest) - 1] = 0;
-    TRACE_(alloy)( "selected policy %s graphics %s default %lu image %s before imports\n",
-                   params.policy_id, params.graphics_provider, params.default_policy, digest );
+    TRACE_(alloy)( "selected policy %s graphics %s cpu %u default %lu image %s before imports\n",
+                   params.entry.id, params.entry.graphics, params.entry.cpu, params.default_policy, digest );
     return;
 
 failed:
-    MESSAGE( "wine: Alloy policy bootstrap failed for %s, status %lx\n",
+    MESSAGE( "wine: Alloy policy failure %s for %s, status %lx\n",
+             params.reason[0] ? params.reason : reason,
              debugstr_w(NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer), status );
     NtTerminateProcess( GetCurrentProcess(), status );
 }
