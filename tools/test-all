def wine_busy_reason(build: Path, processes: str, own_pid: int) -> Optional[str]:
    rows = {}
    for line in processes.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            rows[int(parts[0])] = (int(parts[1]), parts[2])
    # The shell that launched test-all may mention ALLOY_WINE_BUILD in its
    # argv. Exclude only this process and its ancestors, never siblings or
    # descendants (the latter include an actual concurrent Wine invocation).
    ancestors = set()
    pid = own_pid
    while pid and pid not in ancestors:
        ancestors.add(pid)
        pid = rows.get(pid, (0, ""))[0]
    names = {str(build), os.path.realpath(build)}
    if str(build).startswith(("/private/tmp/", "/private/var/")):
        names.add(str(build).removeprefix("/private"))
    for pid, (_, command) in rows.items():
        if pid not in ancestors and any(name in command for name in names):
            return f"build-2 busy: pid {pid} uses {build}"
    return None


def runtime_idle(build: Path) -> Optional[str]:
    try:
        result = subprocess.run(["ps", "-axo", "pid=,ppid=,command="],
                                capture_output=True, text=True, check=True, timeout=5)
    except (OSError, subprocess.SubprocessError) as exc:
        return f"cannot check whether build-2 is busy: {exc}"
    return wine_busy_reason(build, result.stdout, os.getpid())


def need_wine_idle(root: Path) -> Optional[str]:
    return runtime_idle(wine_build(root))


def env_argument(root: Path, variable: str) -> str:
    return str(configured_path(root, variable, "")) if os.environ.get(variable) else f"<{variable}>"


def need_environment_tree(variable: str, *files: str) -> ProbeFn:
    def probe(root: Path) -> Optional[str]:
        if not os.environ.get(variable):
            return f"expected skip by default: no staged release input; set {variable}"
        base = configured_path(root, variable, "")
        if not base.is_dir():
            return f"missing {variable} directory: {base}"
        for name in files:
            if not (base / name).is_file():
                return f"missing {variable} artifact: {base / name}"
        return None
    return probe


def need_codec_runtime(root: Path) -> Optional[str]:
    reason = need_environment_tree("ALLOY_STAGED_RUNTIME", "dlls/ntdll/ntdll.so")(root)
    if reason:
        return reason
    base = configured_path(root, "ALLOY_STAGED_RUNTIME", "")
    if not any((base / name).is_file() for name in ("CODEC-EXCLUSIONS.txt", "config.log")):
        return f"missing staged runtime provenance: {base}/CODEC-EXCLUSIONS.txt or config.log"
    for name in ("ALLOY_CODEC_PROVIDER_DIR", "ALLOY_CODEC_UNIXLIB_DIR"):
        if os.environ.get(name) and not configured_path(root, name, "").is_dir():
            return f"missing {name} directory: {env_argument(root, name)}"
    return None


def need_staged_runtime_idle(root: Path) -> Optional[str]:
    return runtime_idle(configured_path(root, "ALLOY_STAGED_RUNTIME", ""))


def need_bison3(_root: Path) -> Optional[str]:
    try:
        result = subprocess.run(["bison", "--version"], capture_output=True, text=True, check=True, timeout=5)
        version = result.stdout.splitlines()[0].split()[-1]
        if int(version.split(".")[0]) >= 3:
            return None
        return f"bundle proof requires bison 3 or newer; PATH selects {version}"
    except (OSError, subprocess.SubprocessError, IndexError, ValueError) as exc:
        return f"cannot verify bison 3 for the bundle proof: {exc}"


def need_jit_signal_host(_root: Path) -> Optional[str]:
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        return "Darwin JIT signal proof requires an arm64 macOS host"
    return None


def sh(suite_id: str, tier: str, script: str, *args: str, timeout: float, probe: ProbeFn) -> Suite:
    """A suite whose command is a shell script, always run through bash so a
    missing +x bit never turns into a bogus FAIL."""
    return Suite(id=suite_id, tier=tier, cmd=("bash", script, *args), cwd=".", timeout=timeout, probe=probe)


