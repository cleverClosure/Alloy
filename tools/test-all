# Pinned by hand, not derived from len(REGISTRY) — see "Adding a suite" above.
# A constant computed from the list it is meant to audit could never disagree
# with it.
REGISTRY_SUITE_COUNT = 56


# ---------------------------------------------------------------------------
# Engine — used both for the real REGISTRY above and, with a throwaway
# registry of its own, by --selftest. Nothing here is specific to any one
# suite; that is the point.
# ---------------------------------------------------------------------------


def select_suites(registry: Sequence[Suite], tier: str, only: Optional[Sequence[str]]) -> list[Suite]:
    if only:
        unknown = set(only) - {s.id for s in registry}
        if unknown:
            raise UnknownSuite(f"unknown suite id(s): {', '.join(sorted(unknown))}")
    return [
        s
        for s in registry
        if (not only or s.id in only) and (tier == "full" or s.tier == "fast")
    ]


def check_registry_count(registry: Sequence[Suite], expected: int) -> Optional[str]:
    """None when the registry's size matches what was pinned by hand, else a
    reason naming the mismatch. This is the whole defense against a Suite(...)
    silently disappearing in a merge or a refactor: nothing else here would
    ever notice fewer entries than before, because fewer suites still just
    means fewer rows that all say pass."""
    ids = [suite.id for suite in registry]
    duplicates = sorted(key for key, count in Counter(ids).items() if count > 1)
    if duplicates:
        return f"duplicate registry suite id(s): {', '.join(duplicates)}"
    if len(registry) == expected:
        return None
    return (
        f"registry has {len(registry)} suite(s), REGISTRY_SUITE_COUNT says {expected} — "
        "bump the constant next to REGISTRY when a suite is added or removed"
    )


def audit_results(selected: Sequence[Suite], results: Sequence[Result]) -> Optional[str]:
    wanted = Counter(s.id for s in selected)
    reported = Counter(r.id for r in results)
    if wanted != reported:
        missing = list((wanted - reported).elements())
        extra = list((reported - wanted).elements())
        return (f"selected {len(selected)} suite(s), reported {len(results)}; "
                f"missing={missing}, unexpected_or_duplicate={extra}")
    invalid = [r.id for r in results if r.verdict not in ("pass", "fail", "skip")]
    if invalid:
        return f"invalid verdict for suite(s): {', '.join(invalid)}"
    return None


def _kill_process_group(proc: "subprocess.Popen[bytes]", grace_seconds: float = 3) -> None:
    # The suite's shell gets a chance to stop its private Wine server. A
    # final group kill still reaps children that ignore TERM or outlive it.
    try:
        os.killpg(proc.pid, signal.SIGTERM)
        proc.wait(timeout=grace_seconds)
    except (ProcessLookupError, subprocess.TimeoutExpired):
        pass
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass


def run_one(suite: Suite, repo_root: Path) -> Result:
    try:
        reason = suite.probe(repo_root)
    except Exception as exc:
        return Result(suite.id, suite.tier, "fail", f"probe error: {type(exc).__name__}: {exc}", 0.0)
    if reason is not None:
        return Result(suite.id, suite.tier, "skip", reason, 0.0)

    cwd = repo_root if suite.cwd == "." else (repo_root / suite.cwd)
    start = time.monotonic()
    try:
        # A new session (process group) so a timeout can reap the whole tree
        # a shell suite spawned (swift build, a fixture server), not just the
        # one shell process.
        env = dict(os.environ)
        if suite.environment:
            env.update(suite.environment(repo_root))
        proc = subprocess.Popen(list(suite.argv(repo_root)), cwd=str(cwd), env=env, start_new_session=True)
    except Exception as exc:
        return Result(suite.id, suite.tier, "fail", f"could not start: {exc}", time.monotonic() - start)

    try:
        code = proc.wait(timeout=suite.timeout)
    except subprocess.TimeoutExpired:
        _kill_process_group(proc, suite.cleanup_grace)
        elapsed = time.monotonic() - start
        return Result(suite.id, suite.tier, "fail", f"timed out after {suite.timeout:.0f}s", elapsed)

    elapsed = time.monotonic() - start
    if code == 0:
        return Result(suite.id, suite.tier, "pass", None, elapsed)
    return Result(suite.id, suite.tier, "fail", f"exit {code}", elapsed)


def exit_code(results: Sequence[Result]) -> int:
    return 1 if any(r.verdict == "fail" for r in results) else 0


def summary_line(results: Sequence[Result]) -> str:
    passed = sum(1 for r in results if r.verdict == "pass")
    failed = sum(1 for r in results if r.verdict == "fail")
    skipped = sum(1 for r in results if r.verdict == "skip")
    # Skips are never folded into "passed" here — a tool that cannot tell
    # "verified fine" from "never ran" is worse than one that admits it.
    return f"{len(results)} suite(s): {passed} passed, {failed} failed, {skipped} skipped"


def render_table(results: Sequence[Result]) -> str:
    if not results:
        return "(no suites selected)"
    id_w = max(len("SUITE"), max(len(r.id) for r in results))
    tier_w = max(len("TIER"), max(len(r.tier) for r in results))
    verdict_w = max(len("VERDICT"), max(len(r.verdict) for r in results))
    header = f"{'SUITE':<{id_w}}  {'TIER':<{tier_w}}  {'VERDICT':<{verdict_w}}  ELAPSED  REASON"
    lines = [header, "-" * len(header)]
    for r in results:
        lines.append(
            f"{r.id:<{id_w}}  {r.tier:<{tier_w}}  {r.verdict.upper():<{verdict_w}}  "
            f"{r.elapsed:6.1f}s  {r.reason or ''}"
        )
    return "\n".join(lines)


def write_json(results: Sequence[Result], path: str, tier: str, selected: Sequence[Suite]) -> None:
    payload = {
        "tier": tier,
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "selected_count": len(selected),
        "reported_count": len(results),
        "audit_error": audit_results(selected, results),
        "suites": [
            {
                "id": r.id,
                "tier": r.tier,
                "verdict": r.verdict,
                "reason": r.reason,
                "elapsed_seconds": round(r.elapsed, 3),
            }
            for r in results
        ],
    }
    Path(path).write_text(json.dumps(payload, indent=2) + "\n")


# ---------------------------------------------------------------------------
# --selftest — proves pass, fail, skip and timeout against suites it makes up
# itself in a temporary directory, never the REGISTRY above.
# ---------------------------------------------------------------------------


def run_selftest() -> int:
    ok = True

    def check(label: str, cond: bool) -> None:
        nonlocal ok
        print(f"{'ok' if cond else 'FAIL'}: {label}")
        ok = ok and cond

    tmp = tempfile.mkdtemp(prefix="alloy-test-all-selftest.")
    try:
        root = Path(tmp).resolve()

        passing = Suite(
            id="synthetic-pass",
            tier="fast",
            cmd=(sys.executable, "-c", "import sys; sys.exit(0)"),
            cwd=".",
            timeout=10,
            probe=lambda _r: None,
        )
        failing = Suite(
            id="synthetic-fail",
            tier="fast",
            cmd=(sys.executable, "-c", "import sys; print('deliberate failure'); sys.exit(1)"),
            cwd=".",
            timeout=10,
            probe=lambda _r: None,
        )
        # The command points at a path that does not exist. If the skip logic
        # were ever bypassed, this would show up as a startup FAIL rather than
        # a silent PASS — the negative control is built into the fixture.
        unrunnable = Suite(
            id="synthetic-skip",
            tier="fast",
            cmd=(str(root / "does-not-exist"),),
            cwd=".",
            timeout=10,
            probe=lambda _r: "synthetic fixture deliberately absent",
        )
        # Writes its own pid before sleeping, so the timeout check below can
        # confirm the child actually died rather than inferring it from how
        # long run_one() took to return.
        hang_pid_file = root / "hang.pid"
        hanging = Suite(
            id="synthetic-hang",
            tier="full",
            cmd=(
                sys.executable,
                "-c",
                f"import os; open({str(hang_pid_file)!r}, 'w').write(str(os.getpid()))\n"
                "import time, signal\n"
                f"def cleanup(*_):\n open({str(root / 'cleanup.txt')!r}, 'w').write('cleaned'); raise SystemExit(0)\n"
                "signal.signal(signal.SIGTERM, cleanup)\n"
                "time.sleep(30)",
            ),
            cwd=".",
            timeout=1,
            probe=lambda _r: None,
        )
        synthetic = [passing, failing, unrunnable, hanging]

        # 1. A passing suite reports pass.
        r = run_one(passing, root)
        check("a passing suite reports pass", r.verdict == "pass")

        # 2. A failing suite reports fail, is named, and the run exits non-zero.
        pair = [run_one(passing, root), run_one(failing, root)]
        check("a failing suite reports fail", pair[1].verdict == "fail")
        check(
            "the failing suite is the one named, not its neighbour",
            {r.id for r in pair if r.verdict == "fail"} == {"synthetic-fail"},
        )
        check("one failing suite makes the run exit non-zero", exit_code(pair) != 0)

        # 3. An unrunnable suite is SKIP with the probe's exact reason, and
        #    alone it exits zero — a skip is not a failure.
        r = run_one(unrunnable, root)
        check("an unrunnable suite reports skip, not fail or pass", r.verdict == "skip")
        check("the skip carries the probe's exact reason", r.reason == "synthetic fixture deliberately absent")
        check("a run containing only a skip exits zero", exit_code([r]) == 0)

        # 4. A hanging suite is failed by its timeout, well before it would
        #    finish on its own — proves the kill, not just the verdict. Wall
        #    clock alone cannot tell a real kill from a wait() that merely
        #    gave up, so also confirm the child's pid no longer exists —
        #    otherwise a `_kill_process_group` that drops its `os.killpg`
        #    call and relies on the fallback wait would pass this unnoticed,
        #    leaving an orphaned process behind on every real timeout.
        start = time.monotonic()
        r = run_one(hanging, root)
        elapsed = time.monotonic() - start
        check("a hanging suite is failed, never passed", r.verdict == "fail")
        check("its failure names the timeout", "timed out" in (r.reason or ""))
        check("the timeout actually killed it (ran far short of 30s)", elapsed < 10)
        hang_pid = int(hang_pid_file.read_text()) if hang_pid_file.exists() else None
        child_gone = hang_pid is not None
        if hang_pid is not None:
            try:
                os.kill(hang_pid, 0)
                child_gone = False  # still answers to signal 0: still alive
            except ProcessLookupError:
                child_gone = True
        check("the timed-out child process is actually dead, not orphaned", child_gone)
        check("timeout gives the suite's private-resource cleanup a chance to run",
              (root / "cleanup.txt").read_text() == "cleaned")

        # A private filesystem detach may exceed the default TERM grace.
        # Exercise the actual custom allowance, with cleanup delayed past 3s.
        extended_marker = root / "extended-cleanup.txt"
        extended = Suite(
            id="synthetic-extended-cleanup", tier="fast", cwd=".", timeout=0.2,
            cleanup_grace=5, probe=lambda _r: None,
            cmd=(sys.executable, "-c", "import time, signal\n"
                 f"def cleanup(*_):\n time.sleep(3.2); open({str(extended_marker)!r}, 'w').write('cleaned'); "
                 "raise SystemExit(0)\n"
                 "signal.signal(signal.SIGTERM, cleanup)\ntime.sleep(30)"),
        )
        extended_result = run_one(extended, root)
        check("custom cleanup grace waits for resource cleanup beyond default three seconds",
              extended_result.verdict == "fail" and extended_marker.exists())

        # 5. --list's count matches the registry — nothing can silently drop.
        listed = select_suites(synthetic, tier="full", only=None)
        check("--list enumerates exactly the registry it was given", len(listed) == len(synthetic))
        listed_fast = select_suites(synthetic, tier="fast", only=None)
        check(
            "fast tier excludes the full-only synthetic suite",
            "synthetic-hang" not in {s.id for s in listed_fast},
        )

        # 6. --only rejects an id the registry does not have, instead of
        #    silently running nothing.
        try:
            select_suites(synthetic, tier="full", only=["does-not-exist"])
            check("--only on an unknown id is refused", False)
        except UnknownSuite:
            check("--only on an unknown id is refused", True)

        # 7. Same check, but through main()'s own argv handling, not just
        #    select_suites() in isolation — ci.yml never passes --only, but
        #    an UnknownSuite swallowed in main() instead of returned as exit
        #    2 would otherwise go untested forever. Safe to run here: the
        #    bad id makes select_suites() raise before any real Suite's cmd
        #    is ever started.
        check(
            "main() exits 2 for an unknown --only id, not a silent empty run",
            main(["--only", "does-not-exist", "--tier", "fast"]) == 2,
        )

        # 8. The real REGISTRY's size matches what was pinned by hand in
        #    REGISTRY_SUITE_COUNT. This is metadata, not execution — no real
        #    suite's cmd runs — so it does not break "the real suites never
        #    ran", and it is what actually catches a Suite(...) deleted from
        #    REGISTRY: nothing else here ever inspects the real registry.
        check(
            "REGISTRY_SUITE_COUNT matches the real registry",
            check_registry_count(REGISTRY, REGISTRY_SUITE_COUNT) is None,
        )
        check(
            "check_registry_count flags a registry shorter than expected",
            check_registry_count(synthetic, len(synthetic) + 1) is not None,
        )
        check(
            "check_registry_count is silent when the count matches",
            check_registry_count(synthetic, len(synthetic)) is None,
        )

        # 9. summary_line() and render_table() are what a human or CI actually
        #    reads — prove them against a known mix of verdicts directly,
        #    rather than trusting run_one()'s bookkeeping to stand in for them.
        mixed = [
            Result("mixed-pass", "fast", "pass", None, 1.0),
            Result("mixed-fail", "fast", "fail", "exit 1", 2.0),
            Result("mixed-skip", "fast", "skip", "missing on PATH: foo", 0.0),
        ]
        check(
            "summary_line never folds a skip into passed",
            summary_line(mixed) == "3 suite(s): 1 passed, 1 failed, 1 skipped",
        )
        table_rows = {line.split()[0]: line for line in render_table(mixed).splitlines()[2:]}
        check("render_table marks the passing suite PASS", "PASS" in table_rows["mixed-pass"])
        check(
            "render_table marks the failing suite FAIL, not PASS",
            "FAIL" in table_rows["mixed-fail"] and "PASS" not in table_rows["mixed-fail"],
        )
        check(
            "render_table marks the skipped suite SKIP and carries its reason",
            "SKIP" in table_rows["mixed-skip"] and "missing on PATH: foo" in table_rows["mixed-skip"],
        )
        # Full-tier probes exercise real temporary artifacts, without Wine.
        fake_build = root / "Wine build with spaces"
        fake_source = root / "Wine source"
        with patch.dict(os.environ, {"ALLOY_WINE_BUILD": str(fake_build),
                                     "ALLOY_WINE_SOURCE": str(fake_source)}):
            check("missing Wine loader is named precisely",
                  str(fake_build / "loader/wine") in (need_wine_build()(root) or ""))
            for name in ("loader/wine", "server/wineserver", "dlls/ntdll/ntdll.so"):
                path = fake_build / name
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text("fixture")
                path.chmod(0o755)
            check("present Wine artifacts pass their presence probe", need_wine_build()(root) is None)
            check("missing FEX builtin is named precisely",
                  "libarm64ecfex.dll" in (need_wine_build(fex=True)(root) or ""))
            dll = fake_build / "dlls/libarm64ecfex/aarch64-windows/libarm64ecfex.dll"
            dll.parent.mkdir(parents=True); dll.write_text("fixture")
            check("present FEX builtin passes", need_wine_build(fex=True)(root) is None)
            (fake_build / "loader/wine").chmod(0o644)
            check("a non-executable loader skips", "not executable" in (need_wine_build()(root) or ""))
            check("missing shipped decoder header is named",
                  "arm64_jit_store.h" in (need_wine_source(root) or ""))
            header = fake_source / "dlls/ntdll/unix/arm64_jit_store.h"
            header.parent.mkdir(parents=True); header.write_text("fixture")
            check("present shipped decoder header passes", need_wine_source(root) is None)
            check("Wine path overrides are passed to the child",
                  wine_environment(root)["ALLOY_WINE_BUILD"] == str(fake_build))
            busy = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(30)", str(fake_build)])
            try:
                blocked = Suite("busy-runtime", "full", (str(root / "must-not-run"),),
                                ".", 1, need_wine_idle)
                outcome = run_one(blocked, root)
                reason = outcome.reason or ""
                check("a real held process under build-2 causes SKIP",
                      outcome.verdict == "skip" and "build-2 busy" in reason and str(busy.pid) in reason)
            finally:
                busy.terminate(); busy.wait(timeout=5)
            check("the busy skip clears after the held process exits", need_wine_idle(root) is None)
            with patch("subprocess.run", side_effect=FileNotFoundError("ps unavailable")):
                check("a failed ps check never grants permission to run",
                      "cannot check" in (need_wine_idle(root) or ""))

        check("build path in the launching shell is not a false busy match",
              wine_busy_reason(fake_build, f"10 1 shell {fake_build}\n20 10 test-all", 20) is None)
        check("a sibling build process is still busy",
              wine_busy_reason(fake_build, f"10 1 shell\n20 10 test-all\n21 10 build {fake_build}", 20) is not None)
        check("missing tool probe names the absent executable",
              need_commands("alloy-selftest-deliberately-absent")(root)
              == "missing on PATH: alloy-selftest-deliberately-absent")
        dynamic = Suite(
            "dynamic", "full",
            lambda r: (sys.executable, "-c", "import os,sys; assert sys.argv[1] == os.environ['ALLOY_TEST_ARG']", str(r)),
            ".", 10, lambda _r: None,
            environment=lambda r: {"ALLOY_TEST_ARG": str(r)},
        )
        dynamic_root = root / "argv with spaces"
        dynamic_root.mkdir()
        check("dynamic argv preserves spaces and environment reaches the child",
              run_one(dynamic, dynamic_root).verdict == "pass")
        check("Wine and CPU entries never enter the CI fast tier",
              not any(s.id.startswith(("wine-", "cpu-")) for s in select_suites(REGISTRY, "fast", None)))
        # ISA preparation and guest execution share tools, but their verdicts
        # stay separate. Source revisions are metadata only, never source reads.
        isa = {s.id: s for s in REGISTRY if s.id.startswith("cpu-isa-all-")}
        check("ISA native preparation explicitly excludes guest execution",
              "--native-only" in isa["cpu-isa-all-native"].argv(root)
              and "--native-only" not in isa["cpu-isa-all-fex"].argv(root))
        check("an absent aggregate runner is a precise skip",
              "run-isa-corpus.sh" in (isa["cpu-isa-all-native"].probe(root) or ""))
        isa_bin = root / "ISA tools with spaces"
        fex_source = root / "FEX metadata only"
        with patch.dict(os.environ, {"ALLOY_TOOLCHAIN_BIN": isa_bin.name,
                                     "ALLOY_WINE_SOURCE": str(fake_source),
                                     "ALLOY_FEX_SOURCE": str(fex_source)}), \
                patch("platform.system", return_value="Darwin"), \
                patch("platform.machine", return_value="arm64"):
            check("relative ISA toolchain override is rooted at the checkout",
                  isa_environment(root)["ALLOY_TOOLCHAIN_BIN"] == str(isa_bin))
            check("missing ISA cross compiler is named",
                  "x86_64-w64-mingw32-clang" in (need_isa_toolchain(root) or ""))
            isa_bin.mkdir()
            cross = isa_bin / "x86_64-w64-mingw32-clang"
            cross.write_text("fixture"); cross.chmod(0o755)
            check("missing ISA opcode inspector is named",
                  "llvm-objdump" in (need_isa_toolchain(root) or ""))
            inspector = isa_bin / "llvm-objdump"
            inspector.write_text("fixture"); inspector.chmod(0o755)
            check("both executable ISA tools satisfy the probe", need_isa_toolchain(root) is None)
            inspector.chmod(0o644)
            check("a present non-executable ISA tool still skips",
                  "llvm-objdump" in (need_isa_toolchain(root) or ""))
            with patch("platform.machine", return_value="x86_64"):
                check("an Intel host cannot be credited as an ARM reference proof",
                      "arm64 macOS" in (need_isa_toolchain(root) or ""))
            check("missing Wine revision metadata is named",
                  "ALLOY_WINE_SOURCE" in (need_isa_source_metadata(root) or ""))
            (fake_source / ".git").write_text("synthetic worktree metadata")
            check("missing FEX revision metadata is named",
                  "ALLOY_FEX_SOURCE" in (need_isa_source_metadata(root) or ""))
            (fex_source / ".git").mkdir(parents=True)
            check("metadata presence accepts worktree files and checkout directories",
                  need_isa_source_metadata(root) is None)
            check("FEX source override reaches the child intact",
                  isa_environment(root)["ALLOY_FEX_SOURCE"] == str(fex_source))
        with patch.dict(os.environ, {"ALLOY_TOOLCHAIN_BIN": ""}), \
                patch("shutil.which", return_value=str(cross)):
            check("PATH selects the cross compiler's directory without a primary-checkout assumption",
                  isa_toolchain(root) == isa_bin)
        with patch("platform.system", return_value="Darwin"), patch("platform.machine", return_value="arm64"):
            for memory, expected in [(7, "7 GiB"), (8, None), (32, None)]:
                with patch("subprocess.run", return_value=subprocess.CompletedProcess(
                        [], 0, str(memory * (1 << 30)), "")):
                    reason = need_launch_host(root)
                    check(f"launch host probe reports {memory} GiB truthfully",
                          reason is None if expected is None else expected in (reason or ""))
            with patch("subprocess.run", side_effect=FileNotFoundError("sysctl unavailable")):
                host_probe = Suite("launch-host-probe", "fast", ("true",), ".", 1, need_launch_host)
                check("broken host probe fails instead of hiding coverage as SKIP",
                      run_one(host_probe, root).verdict == "fail")
        # Legal proofs opt in through staged inputs; bare checkout is SKIP.
        with patch.dict(os.environ, {"ALLOY_STAGED_RUNTIME": "", "ALLOY_RELEASE_DIR": "",
                                     "ALLOY_CODEC_PROVIDER_DIR": "", "ALLOY_CODEC_UNIXLIB_DIR": ""}):
            legal = [s for s in REGISTRY if s.id.startswith("legal-")]
            check("both legal suites skip by default without starting a command",
                  len(legal) == 2 and all(run_one(s, root).verdict == "skip" for s in legal))
            check("legal list descriptions label expected skips as build-dependent",
                  all("build-dependent" in s.description and "expected SKIP" in s.description for s in legal))
            staged = root / "staged runtime"
            os.environ["ALLOY_STAGED_RUNTIME"] = str(staged)
            check("missing staged runtime directory is named", str(staged) in (need_codec_runtime(root) or ""))
            ntdll = staged / "dlls/ntdll/ntdll.so"
            ntdll.parent.mkdir(parents=True); ntdll.write_text("fixture")
            check("codec presence refuses a tree without provenance",
                  "provenance" in (need_codec_runtime(root) or ""))
            (staged / "CODEC-EXCLUSIONS.txt").write_text("fixture")
            check("staged contents and provenance satisfy the codec presence probe", need_codec_runtime(root) is None)
            os.environ["ALLOY_CODEC_PROVIDER_DIR"] = str(root / "missing providers")
            check("an explicitly requested missing provider directory skips",
                  "ALLOY_CODEC_PROVIDER_DIR" in (need_codec_runtime(root) or ""))
            release_probe = need_environment_tree("ALLOY_RELEASE_DIR", "corresponding-source/wine/wine-src.tar.gz")
            check("bundle probe names the unset release input", "ALLOY_RELEASE_DIR" in (release_probe(root) or ""))
            os.environ["ALLOY_RELEASE_DIR"] = str(root)
            check("bundle probe names the missing source archive", "wine-src.tar.gz" in (release_probe(root) or ""))
            archive = root / "corresponding-source/wine/wine-src.tar.gz"
            archive.parent.mkdir(parents=True); archive.write_text("fixture")
            check("bundle source presence probe accepts the named artifact", release_probe(root) is None)
            check("legal arguments preserve staged paths containing spaces",
                  str(staged) in legal[0].argv(root))
        with patch("subprocess.run", return_value=subprocess.CompletedProcess([], 0, "bison (GNU Bison) 2.3\n", "")):
            check("old system bison produces a precise skip", "2.3" in (need_bison3(root) or ""))
        with patch("subprocess.run", return_value=subprocess.CompletedProcess([], 0, "bison (GNU Bison) 3.8.2\n", "")):
            check("bison 3 satisfies the bundle tool probe", need_bison3(root) is None)
        check("the shared-source substitution proof is never registered",
              not any("prove-substitution.sh" in arg for suite in REGISTRY for arg in suite.argv(root)))
        # The final audit compares identities as well as totals: a duplicate
        # row replacing a lost suite must fail even when both counts match.
        pair_suites = [passing, unrunnable]
        pair_results = [run_one(s, root) for s in pair_suites]
        check("selected and reported suite identities match", audit_results(pair_suites, pair_results) is None)
        check("audit detects a missing result", audit_results(pair_suites, pair_results[:1]) is not None)
        check("audit detects a duplicate replacing a missing row at the same count",
              audit_results(pair_suites, [pair_results[0], pair_results[0]]) is not None)
        check("audit detects an extra result", audit_results(pair_suites, pair_results + pair_results[:1]) is not None)
        check("audit rejects an unknown verdict", audit_results([passing], [replace(pair_results[0], verdict="unknown")]) is not None)
        check("registry rejects duplicate suite IDs even with the correct total",
              check_registry_count([passing, passing], 2) is not None)
        broken_probe = replace(passing, probe=lambda _r: 1 / 0)
        check("a broken probe still produces a named FAIL row", run_one(broken_probe, root).verdict == "fail")

        # Exercise --list, execution, JSON and refusal through the real CLI.
        # Add a suite, remove it, then prove the count in both directions.
        extra = replace(passing, id="synthetic-added-suite")
        for registry in (pair_suites, [*pair_suites, extra], pair_suites):
            with patch.dict(globals(), {"REGISTRY": registry, "REGISTRY_SUITE_COUNT": len(registry), "REPO_ROOT": root}):
                listed_out = io.StringIO()
                with redirect_stdout(listed_out), redirect_stderr(io.StringIO()):
                    listed_code = main(["--list"])
                check(f"--list reports all {len(registry)} synthetic entries",
                      listed_code == 0 and len(listed_out.getvalue().splitlines()) == len(registry))
                json_path = root / "results.json"
                with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
                    ran_code = main(["--json", str(json_path)])
                payload = json.loads(json_path.read_text())
                check(f"execution and JSON report exactly {len(registry)} selected suites",
                      ran_code == 0 and payload["selected_count"] == len(registry)
                      and payload["reported_count"] == len(registry)
                      and payload["audit_error"] is None
                      and {row["id"] for row in payload["suites"]} == {suite.id for suite in registry})
        with patch.dict(globals(), {"REGISTRY": [passing], "REGISTRY_SUITE_COUNT": 1, "REPO_ROOT": root,
                                   "run_one": lambda _suite, _root: Result("lost-suite", "fast", "pass", None, 0)}):
            with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
                code = main(["--json", str(root / "bad-results.json")])
            payload = json.loads((root / "bad-results.json").read_text())
            check("CLI cannot exit green after a reporting mismatch", code == 2 and payload["audit_error"] is not None)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    if ok:
        print("TEST-ALL-SELFTEST: pass — pass/fail/skip/timeout all verified; the real suites never ran")
    else:
        print("TEST-ALL-SELFTEST: FAIL — the engine itself cannot be trusted; see above", file=sys.stderr)
    return 0 if ok else 1


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def main(argv: Optional[Sequence[str]] = None) -> int:
    ap = argparse.ArgumentParser(
        prog="tools/test-all",
        description="Run every test suite this repo has, and say plainly what did not run.",
    )
    ap.add_argument(
        "--tier",
        choices=("fast", "full"),
        default="full",
        help="fast: zero-toolchain suites only; full: fast + everything else (default)",
    )
    ap.add_argument("--only", action="append", metavar="ID", help="run only this suite id (repeatable)")
    ap.add_argument("--list", action="store_true", help="list the selected suites and exit, without running them")
    ap.add_argument("--json", metavar="PATH", help="also write a machine-readable result to PATH")
    ap.add_argument(
        "--selftest",
        action="store_true",
        help="prove the engine against suites it makes up itself; never touches the suites above",
    )
    args = ap.parse_args(argv)

    if args.selftest:
        return run_selftest()

    mismatch = check_registry_count(REGISTRY, REGISTRY_SUITE_COUNT)
    if mismatch:
        print(f"test-all: {mismatch}", file=sys.stderr)
        return 2

    try:
        selected = select_suites(REGISTRY, args.tier, args.only)
    except UnknownSuite as exc:
        print(f"test-all: {exc}", file=sys.stderr)
        return 2

    if args.list:
        for s in selected:
            print(f"{s.id}\t{s.tier}\t{' '.join(s.argv(REPO_ROOT))}\t{s.description}")
        print(f"\n{len(selected)} suite(s) selected (registry has {len(REGISTRY)} total)", file=sys.stderr)
        return 0

    results = []
    for suite in selected:
        print(f"--- {suite.id} ({suite.tier}) ---", flush=True)
        result = run_one(suite, REPO_ROOT)
        results.append(result)
        if result.verdict == "skip":
            print(f"SKIP {suite.id}: {result.reason}")

    print()
    print(render_table(results))
    print(summary_line(results))
    audit_error = audit_results(selected, results)
    print(f"selected={len(selected)} reported={len(results)}")
    if audit_error:
        print(f"test-all: reporting audit failed: {audit_error}", file=sys.stderr)

    if args.json:
        write_json(results, args.json, args.tier, selected)

    return 2 if audit_error else exit_code(results)


if __name__ == "__main__":
    sys.exit(main())
