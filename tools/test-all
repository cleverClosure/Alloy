REPO_ROOT = Path(__file__).resolve().parent.parent

ProbeFn = Callable[[Path], Optional[str]]


@dataclass(frozen=True)
class Suite:
    id: str
    tier: str  # "fast" or "full"
    cmd: Sequence[str]
    cwd: str  # relative to the repo root the suite runs against; "." for that root
    timeout: float  # seconds
    probe: ProbeFn  # returns a skip reason, or None when the suite can run here


@dataclass(frozen=True)
class Result:
    id: str
    tier: str
    verdict: str  # "pass" | "fail" | "skip"
    reason: Optional[str]
    elapsed: float


class UnknownSuite(ValueError):
    """Raised by select_suites when --only names an id the registry has not."""


# ---------------------------------------------------------------------------
# Probes — small, composable presence checks. A suite's probe is the only
# thing standing between "this Mac cannot run that" and a false FAIL, so each
# one names exactly what is missing rather than just failing the suite.
# ---------------------------------------------------------------------------


def need_commands(*names: str) -> ProbeFn:
    """Every named command must resolve on PATH."""

    def probe(_root: Path) -> Optional[str]:
        missing = [n for n in names if shutil.which(n) is None]
        if missing:
            return f"missing on PATH: {', '.join(missing)}"
        return None

    return probe


def need_paths(*relpaths: str) -> ProbeFn:
    """Every path (relative to the suite's repo root) must exist."""

    def probe(root: Path) -> Optional[str]:
        missing = [p for p in relpaths if not (root / p).exists()]
        if missing:
            return f"missing path(s): {', '.join(missing)}"
        return None

    return probe


def every(*probes: ProbeFn) -> ProbeFn:
    """Combine probes — the first reason any of them gives wins."""

    def probe(root: Path) -> Optional[str]:
        for p in probes:
            reason = p(root)
            if reason:
                return reason
        return None

    return probe


def sh(suite_id: str, tier: str, script: str, *args: str, timeout: float, probe: ProbeFn) -> Suite:
    """A suite whose command is a shell script, always run through bash so a
    missing +x bit never turns into a bogus FAIL."""
    return Suite(id=suite_id, tier=tier, cmd=("bash", script, *args), cwd=".", timeout=timeout, probe=probe)


