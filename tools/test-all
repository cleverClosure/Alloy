# ---------------------------------------------------------------------------
# Probes — small, composable presence checks. A suite's probe is the only
# thing standing between "this Mac cannot run that" and a false FAIL, so each
# one names exactly what is missing rather than just failing the suite.
# ---------------------------------------------------------------------------


def need_commands(*names: str) -> ProbeFn:
    """Every named command must resolve on PATH."""

    def probe(_root: Path) -> Optional[str]:
        missing = [n for n in names if shutil.which(n) is None]
        if missing:
            return f"missing on PATH: {', '.join(missing)}"
        return None

    return probe


def need_paths(*relpaths: str) -> ProbeFn:
    """Every path (relative to the suite's repo root) must exist."""

    def probe(root: Path) -> Optional[str]:
        missing = [p for p in relpaths if not (root / p).exists()]
        if missing:
            return f"missing path(s): {', '.join(missing)}"
        return None

    return probe


def every(*probes: ProbeFn) -> ProbeFn:
    """Combine probes — the first reason any of them gives wins."""

    def probe(root: Path) -> Optional[str]:
        for p in probes:
            reason = p(root)
            if reason:
                return reason
        return None

    return probe



def need_launch_host(_root: Path) -> Optional[str]:
    """The unchanged compiler requires a real arm64 host with at least 8 GiB."""
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        return "launch compiler requires arm64 macOS"
    result = subprocess.run(["/usr/sbin/sysctl", "-n", "hw.memsize"], check=True,
                            capture_output=True, text=True, timeout=5)
    memory = int(result.stdout.strip()) // (1 << 30)
    if memory < 8:
        return f"launch compiler requires >=8 GiB; actual host has {memory} GiB (live host-refusal suite still runs)"
    return None


def configured_path(root: Path, variable: str, default: str) -> Path:
    path = Path(os.environ.get(variable) or default).expanduser()
    return (root / path).resolve()


def wine_build(root: Path) -> Path:
    return configured_path(root, "ALLOY_WINE_BUILD", "spikes/WINE-001/work/build-2")


def wine_source(root: Path) -> Path:
    return configured_path(root, "ALLOY_WINE_SOURCE", "third_party/src/wine")


def wine_environment(root: Path) -> dict[str, str]:
    return {"ALLOY_WINE_BUILD": str(wine_build(root)), "ALLOY_WINE_SOURCE": str(wine_source(root))}


def need_wine_build(*, fex: bool = False) -> ProbeFn:
    def probe(root: Path) -> Optional[str]:
        build = wine_build(root)
        for name in ("loader/wine", "server/wineserver", "dlls/ntdll/ntdll.so"):
            if not (build / name).is_file():
                return f"missing Wine build artifact: {build / name} (ALLOY_WINE_BUILD)"
            if name in ("loader/wine", "server/wineserver") and not os.access(build / name, os.X_OK):
                return f"Wine build artifact is not executable: {build / name}"
        dll = build / "dlls/libarm64ecfex/aarch64-windows/libarm64ecfex.dll"
        if fex and not dll.is_file():
            return f"missing FEX builtin DLL: {dll}"
        return None
    return probe


def need_wine_source(root: Path) -> Optional[str]:
    header = wine_source(root) / "dlls/ntdll/unix/arm64_jit_store.h"
    return None if header.is_file() else f"missing Wine source header: {header} (ALLOY_WINE_SOURCE)"


def isa_toolchain(root: Path) -> Path:
    if os.environ.get("ALLOY_TOOLCHAIN_BIN"):
        return configured_path(root, "ALLOY_TOOLCHAIN_BIN", "")
    compiler = shutil.which("x86_64-w64-mingw32-clang")
    return Path(compiler).parent.resolve() if compiler else root / "tools/toolchains/llvm-mingw/bin"


def isa_environment(root: Path) -> dict[str, str]:
    return {**wine_environment(root), "ALLOY_TOOLCHAIN_BIN": str(isa_toolchain(root)),
            "ALLOY_FEX_SOURCE": str(configured_path(root, "ALLOY_FEX_SOURCE", "third_party/src/fex"))}


def need_isa_toolchain(root: Path) -> Optional[str]:
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        return "ISA native reference proof requires an arm64 macOS host"
    if not os.access("/usr/bin/clang", os.X_OK):
        return "missing Apple compiler: /usr/bin/clang"
    directory = isa_toolchain(root)
    for name in ("x86_64-w64-mingw32-clang", "llvm-objdump"):
        path = directory / name
        if not path.is_file() or not os.access(path, os.X_OK):
            return f"missing executable ISA tool: {path} (ALLOY_TOOLCHAIN_BIN or llvm-mingw on PATH)"
    return None


