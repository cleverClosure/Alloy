# Pinned by hand, not derived from len(REGISTRY) — see "Adding a suite" above.
# A constant computed from the list it is meant to audit could never disagree
# with it.
REGISTRY_SUITE_COUNT = 24


# ---------------------------------------------------------------------------
# Engine — used both for the real REGISTRY above and, with a throwaway
# registry of its own, by --selftest. Nothing here is specific to any one
# suite; that is the point.
# ---------------------------------------------------------------------------


def select_suites(registry: Sequence[Suite], tier: str, only: Optional[Sequence[str]]) -> list[Suite]:
    if only:
        unknown = set(only) - {s.id for s in registry}
        if unknown:
            raise UnknownSuite(f"unknown suite id(s): {', '.join(sorted(unknown))}")
    return [
        s
        for s in registry
        if (not only or s.id in only) and (tier == "full" or s.tier == "fast")
    ]


def check_registry_count(registry: Sequence[Suite], expected: int) -> Optional[str]:
    """None when the registry's size matches what was pinned by hand, else a
    reason naming the mismatch. This is the whole defense against a Suite(...)
    silently disappearing in a merge or a refactor: nothing else here would
    ever notice fewer entries than before, because fewer suites still just
    means fewer rows that all say pass."""
    if len(registry) == expected:
        return None
    return (
        f"registry has {len(registry)} suite(s), REGISTRY_SUITE_COUNT says {expected} — "
        "bump the constant next to REGISTRY when a suite is added or removed"
    )


def _kill_process_group(proc: "subprocess.Popen[bytes]") -> None:
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass


def run_one(suite: Suite, repo_root: Path) -> Result:
    reason = suite.probe(repo_root)
    if reason is not None:
        return Result(suite.id, suite.tier, "skip", reason, 0.0)

    cwd = repo_root if suite.cwd == "." else (repo_root / suite.cwd)
    start = time.monotonic()
    try:
        # A new session (process group) so a timeout can reap the whole tree
        # a shell suite spawned (swift build, a fixture server), not just the
        # one shell process.
        proc = subprocess.Popen(list(suite.cmd), cwd=str(cwd), start_new_session=True)
    except OSError as exc:
        return Result(suite.id, suite.tier, "fail", f"could not start: {exc}", time.monotonic() - start)

    try:
        code = proc.wait(timeout=suite.timeout)
    except subprocess.TimeoutExpired:
        _kill_process_group(proc)
        elapsed = time.monotonic() - start
        return Result(suite.id, suite.tier, "fail", f"timed out after {suite.timeout:.0f}s", elapsed)

    elapsed = time.monotonic() - start
    if code == 0:
        return Result(suite.id, suite.tier, "pass", None, elapsed)
    return Result(suite.id, suite.tier, "fail", f"exit {code}", elapsed)


def exit_code(results: Sequence[Result]) -> int:
    return 1 if any(r.verdict == "fail" for r in results) else 0


def summary_line(results: Sequence[Result]) -> str:
    passed = sum(1 for r in results if r.verdict == "pass")
    failed = sum(1 for r in results if r.verdict == "fail")
    skipped = sum(1 for r in results if r.verdict == "skip")
    # Skips are never folded into "passed" here — a tool that cannot tell
    # "verified fine" from "never ran" is worse than one that admits it.
    return f"{len(results)} suite(s): {passed} passed, {failed} failed, {skipped} skipped"


def render_table(results: Sequence[Result]) -> str:
    if not results:
        return "(no suites selected)"
    id_w = max(len("SUITE"), max(len(r.id) for r in results))
    tier_w = max(len("TIER"), max(len(r.tier) for r in results))
    verdict_w = max(len("VERDICT"), max(len(r.verdict) for r in results))
    header = f"{'SUITE':<{id_w}}  {'TIER':<{tier_w}}  {'VERDICT':<{verdict_w}}  ELAPSED  REASON"
    lines = [header, "-" * len(header)]
    for r in results:
        lines.append(
            f"{r.id:<{id_w}}  {r.tier:<{tier_w}}  {r.verdict.upper():<{verdict_w}}  "
            f"{r.elapsed:6.1f}s  {r.reason or ''}"
        )
    return "\n".join(lines)


def write_json(results: Sequence[Result], path: str, tier: str) -> None:
    payload = {
        "tier": tier,
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "suites": [
            {
                "id": r.id,
                "tier": r.tier,
                "verdict": r.verdict,
                "reason": r.reason,
                "elapsed_seconds": round(r.elapsed, 3),
            }
            for r in results
        ],
    }
    Path(path).write_text(json.dumps(payload, indent=2) + "\n")


# ---------------------------------------------------------------------------
# --selftest — proves pass, fail, skip and timeout against suites it makes up
# itself in a temporary directory, never the REGISTRY above.
# ---------------------------------------------------------------------------


def run_selftest() -> int:
    ok = True

    def check(label: str, cond: bool) -> None:
        nonlocal ok
        print(f"{'ok' if cond else 'FAIL'}: {label}")
        ok = ok and cond

    tmp = tempfile.mkdtemp(prefix="alloy-test-all-selftest.")
    try:
        root = Path(tmp)

        passing = Suite(
            id="synthetic-pass",
            tier="fast",
            cmd=(sys.executable, "-c", "import sys; sys.exit(0)"),
            cwd=".",
            timeout=10,
            probe=lambda _r: None,
        )
        failing = Suite(
            id="synthetic-fail",
            tier="fast",
            cmd=(sys.executable, "-c", "import sys; print('deliberate failure'); sys.exit(1)"),
            cwd=".",
            timeout=10,
            probe=lambda _r: None,
        )
        # The command points at a path that does not exist. If the skip logic
        # were ever bypassed, this would show up as a startup FAIL rather than
        # a silent PASS — the negative control is built into the fixture.
        unrunnable = Suite(
            id="synthetic-skip",
            tier="fast",
            cmd=(str(root / "does-not-exist"),),
            cwd=".",
            timeout=10,
            probe=lambda _r: "synthetic fixture deliberately absent",
        )
        # Writes its own pid before sleeping, so the timeout check below can
        # confirm the child actually died rather than inferring it from how
        # long run_one() took to return.
        hang_pid_file = root / "hang.pid"
        hanging = Suite(
            id="synthetic-hang",
            tier="full",
            cmd=(
                sys.executable,
                "-c",
                f"import os; open({str(hang_pid_file)!r}, 'w').write(str(os.getpid()))\n"
                "import time; time.sleep(30)",
            ),
            cwd=".",
            timeout=1,
            probe=lambda _r: None,
        )
        synthetic = [passing, failing, unrunnable, hanging]

        # 1. A passing suite reports pass.
        r = run_one(passing, root)
        check("a passing suite reports pass", r.verdict == "pass")

        # 2. A failing suite reports fail, is named, and the run exits non-zero.
        pair = [run_one(passing, root), run_one(failing, root)]
        check("a failing suite reports fail", pair[1].verdict == "fail")
        check(
            "the failing suite is the one named, not its neighbour",
            {r.id for r in pair if r.verdict == "fail"} == {"synthetic-fail"},
        )
        check("one failing suite makes the run exit non-zero", exit_code(pair) != 0)

        # 3. An unrunnable suite is SKIP with the probe's exact reason, and
        #    alone it exits zero — a skip is not a failure.
        r = run_one(unrunnable, root)
        check("an unrunnable suite reports skip, not fail or pass", r.verdict == "skip")
        check("the skip carries the probe's exact reason", r.reason == "synthetic fixture deliberately absent")
        check("a run containing only a skip exits zero", exit_code([r]) == 0)

        # 4. A hanging suite is failed by its timeout, well before it would
        #    finish on its own — proves the kill, not just the verdict. Wall
        #    clock alone cannot tell a real kill from a wait() that merely
        #    gave up, so also confirm the child's pid no longer exists —
        #    otherwise a `_kill_process_group` that drops its `os.killpg`
        #    call and relies on the fallback wait would pass this unnoticed,
        #    leaving an orphaned process behind on every real timeout.
        start = time.monotonic()
        r = run_one(hanging, root)
        elapsed = time.monotonic() - start
        check("a hanging suite is failed, never passed", r.verdict == "fail")
        check("its failure names the timeout", "timed out" in (r.reason or ""))
        check("the timeout actually killed it (ran far short of 30s)", elapsed < 10)
        hang_pid = int(hang_pid_file.read_text()) if hang_pid_file.exists() else None
        child_gone = hang_pid is not None
        if hang_pid is not None:
            try:
                os.kill(hang_pid, 0)
                child_gone = False  # still answers to signal 0: still alive
            except ProcessLookupError:
                child_gone = True
        check("the timed-out child process is actually dead, not orphaned", child_gone)

        # 5. --list's count matches the registry — nothing can silently drop.
        listed = select_suites(synthetic, tier="full", only=None)
        check("--list enumerates exactly the registry it was given", len(listed) == len(synthetic))
        listed_fast = select_suites(synthetic, tier="fast", only=None)
        check(
            "fast tier excludes the full-only synthetic suite",
            "synthetic-hang" not in {s.id for s in listed_fast},
        )

        # 6. --only rejects an id the registry does not have, instead of
        #    silently running nothing.
        try:
            select_suites(synthetic, tier="full", only=["does-not-exist"])
            check("--only on an unknown id is refused", False)
        except UnknownSuite:
            check("--only on an unknown id is refused", True)

        # 7. Same check, but through main()'s own argv handling, not just
        #    select_suites() in isolation — ci.yml never passes --only, but
        #    an UnknownSuite swallowed in main() instead of returned as exit
        #    2 would otherwise go untested forever. Safe to run here: the
        #    bad id makes select_suites() raise before any real Suite's cmd
        #    is ever started.
        check(
            "main() exits 2 for an unknown --only id, not a silent empty run",
            main(["--only", "does-not-exist", "--tier", "fast"]) == 2,
        )

        # 8. The real REGISTRY's size matches what was pinned by hand in
        #    REGISTRY_SUITE_COUNT. This is metadata, not execution — no real
        #    suite's cmd runs — so it does not break "the real suites never
        #    ran", and it is what actually catches a Suite(...) deleted from
        #    REGISTRY: nothing else here ever inspects the real registry.
        check(
            "REGISTRY_SUITE_COUNT matches the real registry",
            check_registry_count(REGISTRY, REGISTRY_SUITE_COUNT) is None,
        )
        check(
            "check_registry_count flags a registry shorter than expected",
            check_registry_count(synthetic, len(synthetic) + 1) is not None,
        )
        check(
            "check_registry_count is silent when the count matches",
            check_registry_count(synthetic, len(synthetic)) is None,
        )

        # 9. summary_line() and render_table() are what a human or CI actually
        #    reads — prove them against a known mix of verdicts directly,
        #    rather than trusting run_one()'s bookkeeping to stand in for them.
        mixed = [
            Result("mixed-pass", "fast", "pass", None, 1.0),
            Result("mixed-fail", "fast", "fail", "exit 1", 2.0),
            Result("mixed-skip", "fast", "skip", "missing on PATH: foo", 0.0),
        ]
        check(
            "summary_line never folds a skip into passed",
            summary_line(mixed) == "3 suite(s): 1 passed, 1 failed, 1 skipped",
        )
        table_rows = {line.split()[0]: line for line in render_table(mixed).splitlines()[2:]}
        check("render_table marks the passing suite PASS", "PASS" in table_rows["mixed-pass"])
        check(
            "render_table marks the failing suite FAIL, not PASS",
            "FAIL" in table_rows["mixed-fail"] and "PASS" not in table_rows["mixed-fail"],
        )
        check(
            "render_table marks the skipped suite SKIP and carries its reason",
            "SKIP" in table_rows["mixed-skip"] and "missing on PATH: foo" in table_rows["mixed-skip"],
        )
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    if ok:
        print("TEST-ALL-SELFTEST: pass — pass/fail/skip/timeout all verified; the real suites never ran")
    else:
        print("TEST-ALL-SELFTEST: FAIL — the engine itself cannot be trusted; see above", file=sys.stderr)
    return 0 if ok else 1


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def main(argv: Optional[Sequence[str]] = None) -> int:
    ap = argparse.ArgumentParser(
        prog="tools/test-all",
        description="Run every test suite this repo has, and say plainly what did not run.",
    )
    ap.add_argument(
        "--tier",
        choices=("fast", "full"),
        default="full",
        help="fast: zero-toolchain suites only; full: fast + everything else (default)",
    )
    ap.add_argument("--only", action="append", metavar="ID", help="run only this suite id (repeatable)")
    ap.add_argument("--list", action="store_true", help="list the selected suites and exit, without running them")
    ap.add_argument("--json", metavar="PATH", help="also write a machine-readable result to PATH")
    ap.add_argument(
        "--selftest",
        action="store_true",
        help="prove the engine against suites it makes up itself; never touches the suites above",
    )
    args = ap.parse_args(argv)

    if args.selftest:
        return run_selftest()

    mismatch = check_registry_count(REGISTRY, REGISTRY_SUITE_COUNT)
    if mismatch:
        print(f"test-all: {mismatch}", file=sys.stderr)
        return 2

    try:
        selected = select_suites(REGISTRY, args.tier, args.only)
    except UnknownSuite as exc:
        print(f"test-all: {exc}", file=sys.stderr)
        return 2

    if args.list:
        for s in selected:
            print(f"{s.id}\t{s.tier}\t{' '.join(s.cmd)}")
        print(f"\n{len(selected)} suite(s) selected (registry has {len(REGISTRY)} total)", file=sys.stderr)
        return 0

    results = []
    for suite in selected:
        print(f"--- {suite.id} ({suite.tier}) ---")
        result = run_one(suite, REPO_ROOT)
        results.append(result)
        if result.verdict == "skip":
            print(f"SKIP {suite.id}: {result.reason}")

    print()
    print(render_table(results))
    print(summary_line(results))

    if args.json:
        write_json(results, args.json, args.tier)

    return exit_code(results)


if __name__ == "__main__":
    sys.exit(main())
